{
	"manifest_version": 3,
	"name": "Xeu Article Clipper",
	"version": "0.1.0",
	"description": "把网页正文保存为 Markdown，直接写入 content/原始资料/文章",
	"minimum_chrome_version": "110",
	"permissions": ["activeTab", "scripting", "storage", "downloads"],
	"action": {
		"default_title": "剪藏到博客",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
